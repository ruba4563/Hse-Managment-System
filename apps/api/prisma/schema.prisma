// =====================================================
// HSE MANAGEMENT SYSTEM
// CORE DATABASE SCHEMA
// =====================================================

// Prisma Client generation

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Database provider

datasource db {
  provider = "postgresql"
}

// =====================================================
// 1. COMPANY
// =====================================================

model Company {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  code     String  @unique
  address  String?
  phone    String?
  email    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments     Department[]
  projects        Project[]
  employees       Employee[]
  users           User[]
  auditLogs       AuditLog[]
  inspectionTypes InspectionType[]

  @@map("companies")
}

// =====================================================
// 2. DEPARTMENT
// =====================================================

model Department {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @db.Uuid
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("departments")
}

// =====================================================
// 3. PROJECT
// =====================================================

model Project {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  name       String
  code       String
  clientName String?
  startDate  DateTime? @db.Date
  endDate    DateTime? @db.Date
  isActive   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  sites       Site[]
  permits     Permit[]
  inspections Inspection[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("projects")
}

// =====================================================
// 4. SITE
// =====================================================

model Site {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  name      String
  code      String
  location  String?
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id])

  userAccess  UserSiteAccess[]
  permits     Permit[]
  inspections Inspection[]

  @@unique([projectId, code])
  @@index([projectId])
  @@map("sites")
}

// =====================================================
// 5. EMPLOYEE
// =====================================================

model Employee {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  departmentId   String?   @db.Uuid
  employeeNumber String
  fullName       String
  nationalId     String?
  email          String?
  phone          String?
  jobTitle       String?
  employmentType String    @default("EMPLOYEE")
  hireDate       DateTime? @db.Date
  isActive       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  department Department? @relation(fields: [departmentId], references: [id])

  user User?

  @@unique([companyId, employeeNumber])
  @@index([departmentId])
  @@map("employees")
}

// =====================================================
// 6. ROLE
// =====================================================

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

// =====================================================
// 7. PERMISSION
// =====================================================

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  module      String
  action      String
  description String?

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

// =====================================================
// 8. ROLE PERMISSION
// =====================================================

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id])

  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// =====================================================
// 9. USER
// =====================================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  employeeId   String?   @unique @db.Uuid
  roleId       String    @db.Uuid
  username     String    @unique
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLogin    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  employee Employee? @relation(fields: [employeeId], references: [id])

  role Role @relation(fields: [roleId], references: [id])

  siteAccess UserSiteAccess[]
  auditLogs  AuditLog[]

  // ===================================================
  // PERMITS
  // ===================================================

  requestedPermits Permit[] @relation("PermitRequestedBy")
  approvedPermits  Permit[] @relation("PermitApprovedBy")
  rejectedPermits  Permit[] @relation("PermitRejectedBy")
  closedPermits    Permit[] @relation("PermitClosedBy")

  completedPermitChecklistItems PermitChecklistItem[] @relation("PermitChecklistCompletedBy")

  permitApprovalHistory PermitApproval[] @relation("PermitApprovalHistoryApprover")

  // ===================================================
  // INSPECTIONS
  // ===================================================

  inspectionsPerformed Inspection[] @relation("InspectionInspector")

  inspectionsSubmitted Inspection[] @relation("InspectionSubmittedBy")

  inspectionsApproved Inspection[] @relation("InspectionApprovedBy")

  inspectionChecklistResponses InspectionChecklistResponse[] @relation("InspectionChecklistRespondedBy")

  inspectionFindingsCreated InspectionFinding[] @relation("InspectionFindingCreatedBy")

  @@index([companyId])
  @@index([roleId])
  @@map("users")
}

// =====================================================
// 10. USER SITE ACCESS
// =====================================================

model UserSiteAccess {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  siteId String @db.Uuid

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  site Site @relation(fields: [siteId], references: [id])

  @@unique([userId, siteId])
  @@index([siteId])
  @@map("user_site_access")
}

// =====================================================
// 11. AUDIT LOG
// =====================================================

model AuditLog {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  userId    String? @db.Uuid

  action    String
  module    String
  recordId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  user User? @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([module, recordId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =====================================================
// PERMIT MANAGEMENT
// =====================================================

enum PermitStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  REJECTED
  CLOSED
}

enum PermitApprovalDecision {
  APPROVED
  REJECTED
}

model PermitType {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permits Permit[]

  @@map("permit_types")
}

model Permit {
  id String @id @default(uuid()) @db.Uuid

  permitNumber String @unique

  permitTypeId  String @db.Uuid
  projectId     String @db.Uuid
  siteId        String @db.Uuid
  requestedById String @db.Uuid

  location             String?
  contractorDepartment String?

  requiredPpe     String[] @default([])
  hazards         String[] @default([])
  controlMeasures String[] @default([])

  startDateTime DateTime
  endDateTime   DateTime

  status PermitStatus @default(DRAFT)

  description String

  submittedAt DateTime?

  approvedAt   DateTime?
  approvedById String?   @db.Uuid

  rejectedAt      DateTime?
  rejectedById    String?   @db.Uuid
  rejectionReason String?

  activatedAt DateTime?

  closedAt   DateTime?
  closedById String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permitType PermitType @relation(fields: [permitTypeId], references: [id])
  project    Project    @relation(fields: [projectId], references: [id])
  site       Site       @relation(fields: [siteId], references: [id])

  requestedBy User  @relation("PermitRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User? @relation("PermitApprovedBy", fields: [approvedById], references: [id])
  rejectedBy  User? @relation("PermitRejectedBy", fields: [rejectedById], references: [id])
  closedBy    User? @relation("PermitClosedBy", fields: [closedById], references: [id])

  checklistItems PermitChecklistItem[]
  approvals      PermitApproval[]

  @@index([permitTypeId])
  @@index([projectId])
  @@index([siteId])
  @@index([requestedById])
  @@index([approvedById])
  @@index([rejectedById])
  @@index([closedById])
  @@index([status])
  @@index([startDateTime])
  @@index([endDateTime])
  @@map("permits")
}

// =====================================================
// PERMIT CHECKLIST ITEM
// =====================================================

model PermitChecklistItem {
  id       String @id @default(uuid()) @db.Uuid
  permitId String @db.Uuid

  itemText String

  isMandatory Boolean @default(true)
  isCompleted Boolean @default(false)

  displayOrder Int @default(0)

  completedAt   DateTime?
  completedById String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permit      Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)
  completedBy User?  @relation("PermitChecklistCompletedBy", fields: [completedById], references: [id])

  @@index([permitId])
  @@index([completedById])
  @@index([permitId, isMandatory, isCompleted])
  @@map("permit_checklist_items")
}

// =====================================================
// PERMIT APPROVAL HISTORY
// =====================================================

model PermitApproval {
  id       String @id @default(uuid()) @db.Uuid
  permitId String @db.Uuid

  approverId String @db.Uuid

  decision PermitApprovalDecision

  comments String?

  approvalDate DateTime @default(now())

  createdAt DateTime @default(now())

  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)
  approver User   @relation("PermitApprovalHistoryApprover", fields: [approverId], references: [id])

  @@index([permitId])
  @@index([approverId])
  @@index([permitId, approvalDate])
  @@map("permit_approvals")
}

// =====================================================
// INSPECTION MANAGEMENT
// =====================================================

enum InspectionCategory {
  SITE
  EQUIPMENT
  VEHICLE
}

enum InspectionStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  CLOSED
}

enum InspectionResponseResult {
  PASS
  FAIL
  NOT_APPLICABLE
}

enum InspectionFindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InspectionFindingType {
  DEFECT
  OBSERVATION
  UNSAFE_ACT
  UNSAFE_CONDITION
}

// =====================================================
// INSPECTION TYPE
// =====================================================

model InspectionType {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  name        String
  code        String
  category    InspectionCategory
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  templateItems InspectionTemplateItem[]
  inspections   Inspection[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
  @@index([category])
  @@map("inspection_types")
}

// =====================================================
// INSPECTION TEMPLATE ITEM
// =====================================================

model InspectionTemplateItem {
  id               String @id @default(uuid()) @db.Uuid
  inspectionTypeId String @db.Uuid

  itemText String

  sectionName String?

  isMandatory Boolean @default(true)

  displayOrder Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspectionType InspectionType @relation(fields: [inspectionTypeId], references: [id], onDelete: Cascade)

  responses InspectionChecklistResponse[]

  @@index([inspectionTypeId])
  @@index([inspectionTypeId, isActive])
  @@index([inspectionTypeId, displayOrder])
  @@map("inspection_template_items")
}

// =====================================================
// INSPECTION
// =====================================================

model Inspection {
  id String @id @default(uuid()) @db.Uuid

  inspectionNumber String @unique

  inspectionTypeId String @db.Uuid
  projectId        String @db.Uuid
  siteId           String @db.Uuid
  inspectorId      String @db.Uuid

  title       String
  description String?

  scheduledAt DateTime?
  startedAt   DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  closedAt    DateTime?

  submittedById String? @db.Uuid
  approvedById  String? @db.Uuid

  approvalComments String?
  rejectionReason  String?

  status InspectionStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspectionType InspectionType @relation(fields: [inspectionTypeId], references: [id])

  project Project @relation(fields: [projectId], references: [id])

  site Site @relation(fields: [siteId], references: [id])

  inspector User @relation("InspectionInspector", fields: [inspectorId], references: [id])

  submittedBy User? @relation("InspectionSubmittedBy", fields: [submittedById], references: [id])

  approvedBy User? @relation("InspectionApprovedBy", fields: [approvedById], references: [id])

  checklistResponses InspectionChecklistResponse[]
  findings           InspectionFinding[]

  @@index([inspectionTypeId])
  @@index([projectId])
  @@index([siteId])
  @@index([inspectorId])
  @@index([submittedById])
  @@index([approvedById])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("inspections")
}

// =====================================================
// INSPECTION CHECKLIST RESPONSE
// =====================================================

model InspectionChecklistResponse {
  id String @id @default(uuid()) @db.Uuid

  inspectionId String @db.Uuid

  templateItemId String @db.Uuid

  result InspectionResponseResult?

  comments String?

  respondedById String?   @db.Uuid
  respondedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  templateItem InspectionTemplateItem @relation(fields: [templateItemId], references: [id])

  respondedBy User? @relation("InspectionChecklistRespondedBy", fields: [respondedById], references: [id])

  findings InspectionFinding[]

  @@unique([inspectionId, templateItemId])
  @@index([inspectionId])
  @@index([templateItemId])
  @@index([respondedById])
  @@index([result])
  @@map("inspection_checklist_responses")
}

// =====================================================
// INSPECTION FINDING
// =====================================================

model InspectionFinding {
  id String @id @default(uuid()) @db.Uuid

  inspectionId String @db.Uuid

  checklistResponseId String? @db.Uuid

  createdById String @db.Uuid

  findingType InspectionFindingType

  severity InspectionFindingSeverity

  title       String
  description String

  recommendedAction String?

  location String?

  isClosed Boolean @default(false)

  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  checklistResponse InspectionChecklistResponse? @relation(fields: [checklistResponseId], references: [id], onDelete: SetNull)

  createdBy User @relation("InspectionFindingCreatedBy", fields: [createdById], references: [id])

  @@index([inspectionId])
  @@index([checklistResponseId])
  @@index([createdById])
  @@index([findingType])
  @@index([severity])
  @@index([isClosed])
  @@map("inspection_findings")
}
